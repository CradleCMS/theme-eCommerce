{% if settings.topGridShow %}
    <section id="link_grid" class="p-4 pt-16 mb-2 mt-10 items-center text-center">
        {% unless settings.topGridHeading == blank %}
        <h2 class="text-3xl mb-4 font-bold">{{ settings.topGridHeading | t }}</h2>
        {% endunless %}
        <div class="flex gap-4 overflow-x-scroll">
            {% let imgWidth = settings.topGridItemWidth %}
            {% let imgHeight = settings.topGridImgHeight | def:250 %}
            {% for item in settings.topGridItems %}
                <div class="card-body p-0 gap-0 box-item grow-0 shrink-0 {% unless settings.topGridItemWidth == "0" %}w-[{{imgWidth}}px]{% endunless %} items-center text-center {% if settings.topGridBg %} bg-base-100 text-base-content rounded-box p-2 {{ settings.general_shadow }}{% endif %}">
                    {% if item.url.size > 0 %}<a href="{{ item.url }}">{% endif %}
                        {% if item.image != empty %}
                        <img src="{{ item.image | asset_img_url:imgWidth,imgHeight }}" alt="{{ item.alt | t }}" class="mx-auto"/>
                        {% endif %}
                        {% if item.caption %}
                            <h4 class="card-title text-xl mt-4 mb-2 p-1 font-bold justify-center ">{{ item.caption | t }}</h4>
                        {% endif %}
                        {% if item.desc %}
                            <p class="text-center grow-0 mb-2 p-1">{{ item.desc | t }}</p>
                        {% endif %}
                    {% if item.url.size > 0 %}</a>{% endif %}
                </div>
            {% endfor %}
        </div>        
    </section>
{% endif %}

{% if settings.homepage_page != empty %}
    <section class="index-page md:w-auto lg:w-auto max-w-[65rem] mt-10 mx-auto">
        {% let p = pages[settings.homepage_page.id] %}
        <div class="{{ p.format }} prose bg-base-100 text-base-content p-4 md:p-8 lg:p-8 rounded-box {{ settings.general_shadow }}">
            {{ p.html }}
        </div>
    </section>
{% endif %}

{% if settings.section_banner1_show %}
    {% include 'indexBannerSections' %}
{% endif %}

{% if settings.bottomGridShow %}
    <section id="link_grid" class="p-4 pt-16 mb-2 mt-10 items-center text-center">
        {% unless settings.bottomGridHeading == blank %}
        <h2 class="text-3xl mb-4 font-bold">{{ settings.bottomGridHeading | t }}</h2>
        {% endunless %}
        <div class="flex gap-4 overflow-x-scroll">
            {% let imgBWidth = settings.bottomGridItemWidth %}
            {% let imgBHeight = settings.bottomGridImgHeight %}
            {% for item in settings.bottomGridItems %}
                <div class="card-body p-0 gap-0 box-item grow-0 shrink-0{% unless settings.bottomGridItemWidth == "0" %} w-[{{imgBWidth}}px]{% endunless %} items-center text-center {% if settings.bottomGridBg %} bg-base-100 text-base-content rounded-box p-2 {{ settings.general_shadow }}{% endif %}">
                    {% if item.url.size > 0 %}<a href="{{ item.url }}">{% endif %}
                        {% if item.image != empty %}
                        <img src="{{ item.image | asset_img_url:imgBWidth,imgBHeight }}" alt="{{ item.alt | t }}" class="mx-auto"/>
                        {% endif %}
                        {% if item.caption %}
                            <h4 class="card-title text-xl my-2 p-1 font-bold justify-center">{{ item.caption | t }}</h4>
                        {% endif %}
                        {% if item.desc %}
                            <p class="text-center grow-0 mb-2 p-1">{{ item.desc | t }}</p>
                        {% endif %}
                    {% if item.url.size > 0 %}</a>{% endif %}
                </div>
            {% endfor %}
        </div>        
    </section>
{% endif %}

{% if settings.homepage_blog_enabled %}
    {% assign blog = blogs[settings.homepage_blog.id] %}
    <section class="mt-10 mb-2">
        <h2 class="text-3xl mb-4 font-bold text-center">{{ blog.meta.h1 }}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% unless blog == empty %}
            	{% for article in blog.articles limit:3 %}
                    {% include 'blogCard' %}
            	{% endfor %}
            {% endunless %}            
        </div>
    </section>
{% endif %}
