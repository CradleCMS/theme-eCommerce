 <!DOCTYPE html>
<html data-theme="{{ settings.daisy-theme }}" lang="{{ site.lang }}">
    <head>
        {% include 'siteHead' %}
        {{ contentForHeader }}
    </head>
    <body class="bg-{{ settings.body_colors }} text-{{ settings.body_colors }}-content flex flex-col justify-between min-h-[100vh] {% if customer %}customer-logged-in {% endif %}template-{{ template | replace: '.', ' ' | split: ' ' | first | handle }}">
        {% comment %}AlpineJs needs to be here or it won't work{% endcomment %}
        {{ 'alpine.min.js' | script_tag }}
        {% if settings.pageLandingHeader %}
          {% include 'siteHeader' %}
        {% endif %}
         {{ contentForLayout }}
        {% if settings.pageLandingFooter %}
          {% include 'siteFooter' %}
        {% endif %}
    </body>
    {{ 'shop.js' | script_tag }}
    {% if settings.mainNavSearch %}
        {% component 'asearch.js' %}
    {% endif %}
    {% component 'alang.js' %}
    {% component 'acurrency.js' %}
    {% component 'adrawer-cart' %}
</html>
