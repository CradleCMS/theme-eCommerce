<!DOCTYPE html>
<html data-theme="{{ settings.daisy-theme }}" lang="{{ site.lang }}">
    <head>
        {% include 'siteHead' %}
        {{ contentForHeader }}
    </head>
    <body class="bg-{{ settings.body_colors }} text-{{ settings.body_colors }}-content flex flex-col justify-between min-h-[100vh] {% if customer %}customer-logged-in {% endif %}template-{{ template | replace: '.', ' ' | split: ' ' | first | handle }}">
        {% comment %}AlpineJs needs to be here or it won't work{% endcomment %}
        {{ 'alpine.min.js' | script_tag }}
        <div>
            {% include 'siteHeader' %}
            {% if template == "index" %}
                <div id="main-content" tabindex="-1" role="main">
                    {% if settings.header_otf_section %}
                      {% include 'indexHero' %}
                    {% endif %}
                    {% unless contentForLayout == "" %}
                      <div class="max-w-[96rem] mx-auto px-2 md:px-4 pb-10">
                        {{ contentForLayout }}
                      </div>
                    {% endunless %}
                </div>
            {% else %}
            <div id="main-content" class="max-w-[96rem] mx-auto px-2 md:px-4 pb-10" tabindex="-1" role="main">
                {{ contentForLayout }}
            </div>
            {% endif %}
        </div>
        {% include 'siteFooter' %}
    </body>
    {{ 'shop.js' | script_tag }}
    {% if settings.mainNavSearch %}
        {% component 'asearch.js' %}
    {% endif %}
    {% component 'alang.js' %}
    {% component 'acurrency.js' %}
    {% component 'adrawer-cart' %}
</html>
