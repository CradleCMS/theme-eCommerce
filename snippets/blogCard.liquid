<div class="card {{ settings.general_shadow }} bg-base-200">
   {% unless article.image == empty %}
    <figure>
        {% if settings.articleCardImg == "white" %}
            {{ article | img_tag:"500x300","whitefit",class:"p-2 bg-white" }}
        {% elseif settings.articleCardImg == "black" %}
            {{ article | img_tag:"500x300","blackfit",class:"p-2 bg-black" }}
        {% elseif settings.articleCardImg == "square" %}
             {{ article | img_tag:"500x500","cropped" }}
            {% elseif settings.articleCardImg == "landscape" %}
             {{ article | img_tag:"500x300","cropped" }}
        {% else %}
            {{ article | img_tag:"500x" }}
        {% endif %}
    </figure>
  {% endunless %}
  <div class="card-body">
    {% if article.tags.size > 0 %}
        <div class="absolute top-4 right-4">
            {% for tag in article.tags %}
                <div class="mr-1 mb-1 badge badge-accent">
                    <a href="{{blog | url}}?tags={{ tag }}">{{ tag }}</a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    <h2 class="card-title">
      {{ article.title }}
    </h2>
    <div class="text-sm">{% if article.author != blank %}{{ article.author }} on {% endif %}<time pubdate datetime="{{ article.publishAt | date }}">{{ article.publishAt | date }}</time></div>
    {% let excerpt_text = article.excerpt | strip_html %}
		{% unless excerpt_text == "" %}
			<p class="mt-4">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
		{% else %}
			<p class="mt-4">{{ article.content | strip_html | truncatewords: 20 }}</p>
		{% endunless %}
    <div class="card-actions justify-end">
      <a class="btn bg-primary text-primary-content" href="{{ article | url }}">{{ lang.read_more | def:'Read' }}</a>
    </div>
  </div>
</div>
